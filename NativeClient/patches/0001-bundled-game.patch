+bool hasNoSymbolicLinks(NSFileManager* manager, NSURL* directory, NSError** error) {
+	__block NSError* enumerationError = nil;
+	NSDirectoryEnumerator* entries = [manager enumeratorAtURL:directory
+		includingPropertiesForKeys:@[NSURLIsSymbolicLinkKey] options:0
+		errorHandler:^BOOL(NSURL* url, NSError* failure) { enumerationError = failure; return NO; }];
+	if(!entries)
