+epro::path_string getWorkDir() {
+	@autoreleasepool {
+		NSFileManager* manager = [NSFileManager defaultManager];
+		NSError* error = nil;
+		NSURL* bundledGame = [[[NSBundle mainBundle] resourceURL] URLByAppendingPathComponent:@"game" isDirectory:YES];
+		NSData* bundledManifest = validateGameFolder(manager, bundledGame, &error);
+		if(!bundledManifest || !hasNoSymbolicLinks(manager, bundledGame, &error)) {
+			reportBootstrapError(error.localizedDescription ?: @"The application has no valid bundled game package.");
+			return {};
+		}
+		NSURL* documents = [manager URLForDirectory:NSDocumentDirectory inDomain:NSUserDomainMask
+			appropriateForURL:nil create:YES error:&error];
+		if(!documents) {
+			reportBootstrapError(error.localizedDescription ?: @"Cannot open Documents.");
+			return {};
+		}
+		NSURL* destination = [documents URLByAppendingPathComponent:@"EDOPro" isDirectory:YES];
+		if([manager fileExistsAtPath:destination.path]) {
+			NSData* installedManifest = validateGameFolder(manager, destination, &error);
+			// shortcut: preserve existing user data on package changes; add explicit migration before supporting upgrades.
+			if(!installedManifest || ![installedManifest isEqualToData:bundledManifest]
+				|| !hasNoSymbolicLinks(manager, destination, &error)) {
+				reportBootstrapError(@"Documents/EDOPro contains a different or invalid game package. Nothing was overwritten. Back up your decks/replays; automatic migration is not implemented.");
+				return {};
+			}
+			return epro::path_string(destination.path.UTF8String);
+		}
+		NSString* stageName = [@".EDOPro-staging-" stringByAppendingString:[NSUUID UUID].UUIDString];
+		NSURL* staging = [documents URLByAppendingPathComponent:stageName isDirectory:YES];
+		bool copied = [manager copyItemAtURL:bundledGame toURL:staging error:&error];
+		NSData* stagedManifest = copied ? validateGameFolder(manager, staging, &error) : nil;
+		if(copied && stagedManifest && [stagedManifest isEqualToData:bundledManifest]
+			&& [manager moveItemAtURL:staging toURL:destination error:&error])
+			return epro::path_string(destination.path.UTF8String);
+		NSString* message = error.localizedDescription ?: @"Could not complete the bundled game installation.";
+		NSError* cleanupError = nil;
+		if([manager fileExistsAtPath:staging.path] && ![manager removeItemAtURL:staging error:&cleanupError])
+			fprintf(stderr, "EDOPro staging cleanup failed: %s\n", cleanupError.localizedDescription.UTF8String);
+		reportBootstrapError(message);
+		return {};
 	}
 }
 
