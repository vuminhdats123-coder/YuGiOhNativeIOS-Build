+epro::mutex metrics_mutex;
+IosViewMetrics view_metrics;
+std::atomic_bool metrics_pending{false};
+
+void requestViewMetrics() {
+	static auto next_update = std::chrono::steady_clock::time_point{};
+	const auto now = std::chrono::steady_clock::now();
+	if(now < next_update || metrics_pending.exchange(true)) return;
+	next_update = now + std::chrono::milliseconds(200);
+	dispatch_async(dispatch_get_main_queue(), ^{
+		UIView* renderView = nil;
+		// The legacy Irrlicht app owns the key window; ignore presented alert-controller bounds.
+		for(UIWindow* window in [UIApplication sharedApplication].windows) {
+			if(window.isKeyWindow) { renderView = window.rootViewController.view; break; }
+		}
+		if(renderView.window) {
+			const auto bounds = renderView.bounds;
+			const auto insets = renderView.safeAreaInsets;
+			if(std::isfinite(bounds.size.width) && std::isfinite(bounds.size.height)
+				&& bounds.size.width > 0 && bounds.size.height > 0) {
+				auto fraction = [](double value, double size) {
+					return std::isfinite(value) ? std::clamp(value / size, 0.0, 0.45) : 0.0;
+				};
+				IosViewMetrics next{fraction(insets.left, bounds.size.width), fraction(insets.top, bounds.size.height),
+					fraction(insets.right, bounds.size.width), fraction(insets.bottom, bounds.size.height),
+					bounds.size.width, bounds.size.height, 0};
+				std::lock_guard<epro::mutex> lock(metrics_mutex);
+				if(next.left != view_metrics.left || next.top != view_metrics.top
+					|| next.right != view_metrics.right || next.bottom != view_metrics.bottom
+					|| next.viewWidthPoints != view_metrics.viewWidthPoints || next.viewHeightPoints != view_metrics.viewHeightPoints) {
+					next.revision = view_metrics.revision + 1;
+					view_metrics = next;
+				}
+			}
+		}
+		metrics_pending = false;
+	});
 }
 
