+	if(infosExpanded == 1) region.right = layout.content.right - std::max(2, layout.content.Width() / 128);
+	wInfos->setRelativePosition({region.left, region.top, region.right, region.bottom});
+	const auto panel = tabLog->getRelativePosition().getSize();
+	if(panel.Width < 16 || panel.Height < 16) return;
+	const int width = std::max(1, panel.Width), height = std::max(1, panel.Height);
+	const int margin = std::max(2, std::min(width / 24, height / 24));
+	const int footer = std::min(std::max(layout.minimumTouchPixels, Scale(26)), std::max(1, height / 3));
+	const auto leftButton = irr::core::recti(margin, height - footer - margin, width / 2 - margin, height - margin);
+	const auto rightButton = irr::core::recti(width / 2 + margin, height - footer - margin, width - margin, height - margin);
+	btnExpandLog->setRelativePosition(leftButton);
+	btnExpandChat->setRelativePosition(leftButton);
+	btnClearLog->setRelativePosition(rightButton);
+	btnClearChat->setRelativePosition(rightButton);
+	const auto listRect = irr::core::recti(margin, margin, width - margin, std::max(margin + 1, height - footer - 2 * margin));
+	lstLog->setRelativePosition(listRect);
+	lstChat->setRelativePosition(listRect);
+	const int nameWidth = std::max(1, stName->getParent()->getRelativePosition().getWidth());
+	stName->setRelativePosition({margin, Scale(10), std::max(margin + 1, nameWidth - margin), Scale(32)});
+#endif
+}
