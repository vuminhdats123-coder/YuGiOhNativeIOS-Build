+}
+
+void Game::RefreshDuelControlsLayout() {
+#if EDOPRO_IOS
+	if(!wDuelTools) return;
+	const auto layout = GetDuelLayout();
+	if(!layout.valid || !dInfo.isInDuel || dInfo.isReplay) {
+		btnDuelTools->setVisible(false);
+		CloseDuelControls();
+		return;
+	}
+	const auto controls = duelui::MakeHudControls(layout);
+	const auto rect = [](duelui::Rect r) { return irr::core::recti(r.left, r.top, r.right, r.bottom); };
+	btnDuelTools->setRelativePosition(rect(controls.menu));
+	btnDuelTools->setVisible(true);
+	// Keep the exit action reachable on iOS even before the first turn callback
+	// updates the legacy desktop button visibility.  The text follows the same
+	// localized rules used by SetMessageWindow.
+	if(!dInfo.isReplay && dInfo.isInDuel) {
+		if(dInfo.player_type == 7)
+			btnLeaveGame->setText(gDataManager->GetSysString(1350).data());
+		else if(dInfo.isSingleMode)
+			btnLeaveGame->setText(gDataManager->GetSysString(1210).data());
+		else if(dInfo.player_type < (dInfo.team1 + dInfo.team2))
+			btnLeaveGame->setText(gDataManager->GetSysString(1351).data());
+		btnLeaveGame->setVisible(true);
+	}
+	// Cancel/Finish covers phase controls while an engine selection is pending.
+	btnCancelOrFinish->setRelativePosition(rect(layout.phase));
+	irr::gui::IGUIButton* buttons[] = {btnChainIgnore, btnChainAlways, btnChainWhenAvail, btnSpectatorSwap, btnRestartSingle, btnLeaveGame};
+	int rows = 1;
+	for(auto* button : buttons) if(button->isVisible()) ++rows;
+	const int margin = std::max(2, std::min(layout.content.Width(), layout.content.Height()) / 64);
+	const int width = std::min(layout.content.Width() - 2 * margin, std::max(4 * layout.minimumTouchPixels, layout.board.Width() / 2));
+	const int height = std::min(layout.content.Height() - 2 * margin, rows * std::max(layout.minimumTouchPixels, Scale(36)) + 2 * margin);
+	const int x = std::clamp(layout.board.left + (layout.board.Width() - width) / 2, layout.content.left + margin, layout.content.right - margin - width);
+	const int y = layout.content.top + (layout.content.Height() - height) / 2;
+	wDuelTools->setRelativePosition({x, y, x + width, y + height});
+	const int rowHeight = std::max(1, (height - 2 * margin) / rows);
+	const auto rowRect = [&](int row) { const int top = margin + row * rowHeight; return irr::core::recti(margin, top, width - margin, top + rowHeight - 1); };
+	btnDuelToolsClose->setRelativePosition(rowRect(0));
+	int row = 1;
+	for(auto* button : buttons) if(button->isVisible()) button->setRelativePosition(rowRect(row++));
+#endif
+}
