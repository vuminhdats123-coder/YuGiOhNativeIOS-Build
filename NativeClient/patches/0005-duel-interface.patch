+void ClientField::PreviewCardListCard(int slot, bool display) {
+	const auto& cards = display ? display_cards : selectable_cards;
+	const auto index = CardListIndex(slot, display);
+	if(index >= cards.size()) return;
+	auto* card = cards[index];
+	SetShowMark(card, true);
+	ShowCardInfoInList(card, display ? mainGame->btnCardDisplay[slot] : mainGame->btnCardSelect[slot],
+		display ? mainGame->wCardDisplay : mainGame->wCardSelect);
+	if(card->code) mainGame->ShowCardInfo(card->code);
+	else if(card->cover) mainGame->ShowCardInfo(card->cover, false, imgType::COVER);
+	else mainGame->ClearCardInfo(card->controler);
+}
+void ClientField::ShowSelectCard(bool buttonok, bool chain) {
+	(void)chain;
+	select_panel_chain = false;
+	if(mainGame->dInfo.curMsg != MSG_SORT_CHAIN && mainGame->dInfo.curMsg != MSG_SORT_CARD) sort_list.clear();
+	mainGame->scrCardList->setPos(0);
+	SetSelectCardOK(buttonok);
+	RefreshCardPanelsLayout();
+	RefreshCardList(false);
 	mainGame->PopupElement(mainGame->wCardSelect);
 }
