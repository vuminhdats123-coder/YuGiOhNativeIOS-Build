+std::size_t ClientField::CardListOffset(bool display) const {
+	const auto& cards = display ? display_cards : selectable_cards;
+	const int position = (display ? mainGame->scrDisplayList : mainGame->scrCardList)->getPos();
+#if EDOPRO_IOS
+	return selectionui::Offset(position, cards.size());
+#else
+	const auto maximum = cards.size() > CardListSlotCount ? cards.size() - CardListSlotCount : 0;
+	return std::min(static_cast<std::size_t>(std::max(0, position / 10)), maximum);
+#endif
+}
+std::size_t ClientField::CardListIndex(int slot, bool display) const {
+	const auto& cards = display ? display_cards : selectable_cards;
+#if EDOPRO_IOS
+	return selectionui::Index(slot, (display ? mainGame->scrDisplayList : mainGame->scrCardList)->getPos(), cards.size());
+#else
+	if(slot < 0 || slot >= CardListSlotCount) return cards.size();
+	const auto index = CardListOffset(display) + static_cast<std::size_t>(slot);
+	return index < cards.size() ? index : cards.size();
+#endif
+}
+void ClientField::RefreshCardPanelsLayout() {
+#if EDOPRO_IOS
+	const auto layout = mainGame->GetDuelLayout();
+	const auto& r = layout.selection;
+	const irr::core::recti panelRect = layout.valid ? irr::core::recti(r.left, r.top, r.right, r.bottom)
+		: irr::core::recti(0, 0, 1, 1);
+	mainGame->wCardSelect->setRelativePosition(panelRect);
+	mainGame->wCardDisplay->setRelativePosition(panelRect);
+	// An in-flight show/hide must finish at the resized rectangle without losing its response signal.
+	for(auto& fade : mainGame->fadingList) {
+		if(fade.guiFading != mainGame->wCardSelect && fade.guiFading != mainGame->wCardDisplay) continue;
+		fade.fadingSize = panelRect;
+		fade.fadingUL = panelRect.UpperLeftCorner;
+		fade.fadingLR = panelRect.LowerRightCorner;
+		fade.fadingDest = {0, 0};
+		// Finish on the next draw tick, which restores images and delivers a pending hide response.
+		// Setting the frame directly to zero would skip that completion path.
+		if(fade.fadingFrame > 0.0f) fade.fadingFrame = std::min(fade.fadingFrame, 1.0f);
+	}
+	mainGame->wCardSelect->setDraggable(false);
+	mainGame->wCardDisplay->setDraggable(false);
+	// Hidden panels may retain references from an old prompt; only repaint live visible lists.
+	if(mainGame->wCardSelect->isVisible()) RefreshCardList(false);
+	if(mainGame->wCardDisplay->isVisible()) RefreshCardList(true);
+#endif
+}
+void ClientField::SetSelectCardOK(bool visible) {
+	select_panel_ok = visible;
+	mainGame->btnSelectOK->setVisible(visible && select_panel_layout_valid);
+}
