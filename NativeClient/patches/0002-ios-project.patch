diff --git a/gframe/premake5.lua b/gframe/premake5.lua
index 190cf9e..cc15b58 100644
--- a/gframe/premake5.lua
+++ b/gframe/premake5.lua
@@ -1,3 +1,11 @@
+local native_ios
+if os.istarget("ios") then
+	if _OPTIONS["no-core"] or _OPTIONS["prebuilt-core"] then
+		error("The iOS port requires the pinned static ocgcore and Lua source projects.", 0)
+	end
+	native_ios = dofile("iOS/native_config.lua")
+end
+
 local ygopro_config=function(static_core)
 	kind "WindowedApp"
 	cppdialect "C++17"
@@ -184,7 +192,7 @@ local ygopro_config=function(static_core)
 			links { "ldap", "Cocoa.framework", "IOKit.framework", "OpenGL.framework", "Security.framework", "SystemConfiguration.framework" }
 		else
 			files { "iOS/**" }
-			links { "UIKit.framework", "CoreMotion.framework", "OpenGLES.framework", "Foundation.framework", "QuartzCore.framework" }
+			links { "UIKit.framework", "CoreMotion.framework", "OpenGLES.framework", "Foundation.framework", "QuartzCore.framework", "c++" }
 		end
 
 	filter { "system:macosx or ios", "configurations:Debug" }
@@ -202,9 +210,6 @@ local ygopro_config=function(static_core)
 
 	filter { "system:ios" }
 		files { "ios-Info.plist" }
-		xcodebuildsettings {
-			["PRODUCT_BUNDLE_IDENTIFIER"] = "io.github.edo9300.ygopro" .. (static_core and "" or "dll")
-		}
 
 	filter { "system:macosx" }
 		files { "Info.plist" }
@@ -264,6 +269,7 @@ local ygopro_config=function(static_core)
 		libdirs { _OPTIONS["prebuilt-core"] }
 	end
 	links { "ocgcore", "lua" }
+	if native_ios then native_ios.configure(static_core) end
 end
 
 include "lzma/."
@@ -277,6 +283,10 @@ if not _OPTIONS["no-core"] then
 		ygopro_config(true)
 end
 
-project "ygoprodll"
-	targetname "ygoprodll"
-	ygopro_config()
+if not os.istarget("ios") then
+	project "ygoprodll"
+		targetname "ygoprodll"
+		ygopro_config()
+end
+
+if native_ios then native_ios.configure_libraries() end
