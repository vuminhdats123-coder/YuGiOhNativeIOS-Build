+	face->name = "Card " + std::to_string(code);
+	face->description = "Card metadata unavailable.";
+	const auto* card = gDataManager->GetCardData(code);
+	if(!card) card = gDataManager->GetMappedCardData(code);
+	if(card) {
+		face->known = true;
+		face->type = card->type; face->attribute = card->attribute; face->level = card->level;
+		face->attack = card->attack; face->defense = card->defense;
+		face->leftScale = card->lscale; face->rightScale = card->rscale; face->linkMarkers = card->link_marker;
+		face->name = BufferIO::EncodeUTF8(gDataManager->GetName(card->code));
+		face->description = BufferIO::EncodeUTF8(gDataManager->GetText(card->code));
+		face->typeLine = BufferIO::EncodeUTF8(gDataManager->FormatType(card->type));
+		if(card->type & TYPE_MONSTER)
+			face->typeLine = BufferIO::EncodeUTF8(gDataManager->FormatRace(card->race)) + " / " + face->typeLine;
+		face->attributeText = (card->type & TYPE_SPELL) ? "SPELL" : (card->type & TYPE_TRAP) ? "TRAP"
+			: BufferIO::EncodeUTF8(gDataManager->FormatAttribute(card->attribute));
+	}
+	return face;
+#else
+	(void)code; (void)type;
+	return nullptr;
+#endif
