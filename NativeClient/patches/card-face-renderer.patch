+void ImageManager::ClearDuelPortraits() {
+	for(int player = 0; player < 2; ++player) {
+		if(duel_portraits[player]) {
+			if(player == 0 && duel_portraits[1] == duel_portraits[0]) duel_portraits[1] = nullptr;
+			driver->removeTexture(duel_portraits[player]);
+			duel_portraits[player] = nullptr;
+		}
+	}
+	duel_opponent_name.clear();
+}
+void ImageManager::SetDuelPortraits(epro::path_stringview opponentDeck, bool offline) {
+	// This is called on the GUI/render thread before starting a duel, never from the AI worker.
+	ClearDuelPortraits();
+#if EDOPRO_IOS
+	if(!offline) return;
+	duel_portraits[0] = driver->getTexture(EPRO_TEXT("./textures/portraits/player.png"));
+	FileStream file{ EPRO_TEXT("./config/duel-portraits.json"), FileStream::in };
+	if(file.fail()) return;
+	try {
+		nlohmann::json catalog;
+		file >> catalog;
+		if(catalog.value("schemaVersion", 0) != 1 || !catalog.at("decks").is_object()) return;
+		const auto entry = catalog["decks"].find(Utils::ToUTF8IfNeeded(opponentDeck));
+		if(entry == catalog["decks"].end() || !entry->is_object()) return;
+		const auto icon = entry->at("icon").get<std::string>();
+		if(!duelui::PortraitIconIsSafe(icon)) return;
+		duel_opponent_name = BufferIO::DecodeUTF8(entry->at("displayName").get<std::string>());
+		duel_portraits[1] = driver->getTexture(epro::format(EPRO_TEXT("./textures/portraits/{}"), Utils::ToPathString(icon)).data());
+	} catch(const std::exception& error) {
+		ErrorLog("Duel portrait catalog could not be read: {}", error.what());
+	}
+#else
+	(void)opponentDeck; (void)offline;
+#endif
+}
