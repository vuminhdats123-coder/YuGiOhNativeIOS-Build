+std::shared_ptr<const CardFaceData> ImageManager::SnapshotCardFace(uint32_t code, imgType type) const {
+#if EDOPRO_IOS
+	if(type != imgType::ART && type != imgType::THUMB) return nullptr;
+	auto face = std::make_shared<CardFaceData>();
